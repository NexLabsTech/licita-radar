{$RADAR_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 4MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    reverse_proxy web:8000 {
        health_uri /healthz
        health_interval 30s
        health_timeout 4s
    }
}
