# Arquivo sem credenciais (ops/runtime/app.env).
APP_ENV=production
COOKIE_SECURE=1
LOGIN_USERNAME=admin
DB_PATH=/app/data/licitaradar.db
AUTO_SCAN_ENABLED=1
AUTO_SCAN_INTERVAL_MINUTES=360
AUTO_SCAN_UF=SP
# A IA permanece desligada para impedir gastos não autorizados.
AI_ENABLED=0
AI_PROVIDER=deepseek
AI_MODEL=
AI_DAILY_LIMIT=10
